# TrainLuma — environment example. PLACEHOLDERS ONLY.
# Copy to .env.local (git-ignored) when a Supabase project exists (Phase 1+).
# Phase 0 needs NO environment variables: the app runs fully local with synthetic data.

# --- Browser-safe values (Vite exposes VITE_* to the browser bundle) ---
# Public project URL and *publishable* key only. Safe ONLY with correct grants + RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- NEVER put these in a VITE_ variable or in this file with real values ---
# GEMINI_API_KEY and Supabase secret/service-role keys belong ONLY in
# Supabase Edge Function secrets, entered by the owner in the Supabase dashboard.
# There is intentionally no VITE_GEMINI_API_KEY.
